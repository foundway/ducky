motes":[],"Blockly.RemotePlus":[{"id":"__title","blockId":"","createTime":1782586773384,"name":"M5RemoteTitle","dragAndDrop":false,"resizable":false,"options":{"minWidth":1,"minHeight":1,"maxWidth":6,"maxHeight":10,"defaultWidth":2,"defaultHeight":1},"w":2,"h":1,"bgColor":"#0080FF","color":"#fff","fontsize":"M","label":"M5Remote","interval":3000,"code":"","event":"","dataSource":"none","ezdataToken":"","topic":"","needShadow":false,"type":"title","x":0,"y":0},{"id":"j*w&r$U3u5d#hkOB","blockId":"H3__X7SIl2|fr?bgLqX1","createTime":1782603397971,"name":"Direction","dragAndDrop":true,"resizable":true,"options":{"minWidth":4,"minHeight":4,"maxWidth":6,"maxHeight":10,"defaultWidth":6,"defaultHeight":6},"w":6,"h":6,"showTitle":false,"xMin":-100,"xMax":100,"yMin":-100,"yMax":100,"color":"#0080ff","autoReturn":true,"needShadow":false,"code":"def joystick_Direction_callback(joystick_x_value, joystick_y_value):\n  global center, command, angle, bias \n  if joystick_y_value > 50:\n    command = 1\n  if joystick_x_value > 50 and joystick_y_value < 50:\n    command = 2\n  if joystick_x_value < -50 and joystick_y_value < 50:\n    command = 3\n  if math.fabs(joystick_x_value) < 50 and joystick_y_value < 50:\n    command = 0\n  comm.setText(str(command))\n","event":"joystick_Direction_callback","type":"joystick","x":0,"y":0},{"id":"FE-mxWF7_XW5@8PW","blockId":"%wO!9ft.l%.7z(;H${@b","createTime":1782607399030,"name":"Tweak","dragAndDrop":true,"resizable":true,"options":{"minWidth":4,"minHeight":4,"maxWidth":6,"maxHeight":10,"defaultWidth":6,"defaultHeight":6},"w":6,"h":4,"showTitle":false,"xMin":-100,"xMax":100,"yMin":-100,"yMax":100,"color":"#0080ff","autoReturn":false,"needShadow":false,"code":"def joystick_Tweak_callback(joystick_x_value, joystick_y_value):\n  global center, command, angle, bias \n  center = math.remap(joystick_x_value, (-100), 100, 80, 100)\n  angle = math.remap(joystick_y_value, (-100), 100, 10, 50)\n","event":"joystick_Tweak_callback","type":"joystick","x":0,"y